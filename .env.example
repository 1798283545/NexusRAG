# OpenAI / DeepSeek 等 LLM 提供商的 API 密钥
OPENAI_API_KEY=your-api-key-here
# 对话模型名称（可替换为 deepseek-chat 等 DeepSeek 模型）
MODEL_NAME=gpt-3.5-turbo
# 生成温度（越低越稳定）
TEMPERATURE=0.3
# 单次生成最大 Token 数
MAX_TOKENS=2048
# Embedding 向量化模型（本地场景可换 BAAI/bge-small-zh-v1.5）
EMBEDDING_MODEL=text-embedding-ada-002
# ChromaDB 主机地址
CHROMA_HOST=localhost
# ChromaDB 服务端口
CHROMA_PORT=8000
# ChromaDB 本地持久化目录（未连接远程服务时生效）
CHROMA_PERSIST_DIR=./chroma_data
# 默认向量集合名
COLLECTION_NAME=nexusrag_docs
# RAG 检索默认 Top-K
DEFAULT_K=4
# 默认分块大小 / 重叠（字符数）
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
# 默认分块策略（recursive / semantic / markdown）
DEFAULT_STRATEGY=recursive
# 混合检索融合策略（weighted 加权和 / rrf 排序融合）
HYBRID_FUSION_STRATEGY=weighted
# 加权融合：向量路 / BM25 路权重
HYBRID_WEIGHT_VECTOR=0.5
HYBRID_WEIGHT_BM25=0.5
# RRF 融合常数 k
HYBRID_RRF_K=60
# 混合检索默认 Top-K
HYBRID_TOP_K=10
# 对话记忆类型（buffer 全量 / buffer_window 滑动窗口 / summary 摘要压缩）
MEMORY_TYPE=buffer_window
# 记忆保留的最近消息条数
MEMORY_WINDOW_SIZE=10
# summary 摘要的最大 Token 约束
MEMORY_SUMMARY_MAX_TOKENS=200
# 记忆变量返回消息对象（true）还是文本（false）
MEMORY_RETURN_MESSAGES=true
# Cross-Encoder 重排模型（英文默认 ms-marco；中文可换 BAAI/bge-reranker-base）
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# 重排推理设备（cpu / cuda / auto）
RERANKER_DEVICE=cpu
# 重排批量推理大小
RERANKER_BATCH_SIZE=32
# 重排输入序列最大长度
RERANKER_MAX_LENGTH=512
# 是否启用半精度加速（仅 GPU 生效）
RERANKER_USE_FP16=false
# 重排阈值过滤（0 表示不过滤，供调用方读取后传入 filter_by_threshold）
RERANKER_THRESHOLD=0.0
# 智能体工作目录（限制文件读写 / 图表生成的落盘范围）
AGENT_WORKSPACE_DIR=./workspace
# 是否打印智能体详细执行日志
AGENT_VERBOSE=true
# 单个智能体最大推理迭代次数（防止死循环）
AGENT_MAX_ITERATIONS=5
# 代码执行工具单次超时（秒）
AGENT_CODE_TIMEOUT=30
# Supervisor 是否并行执行独立子任务
SUPERVISOR_ENABLE_PARALLEL=true
# 任务规划失败后的最大重试次数
SUPERVISOR_MAX_PLANNING_ATTEMPTS=3
# 单个子任务执行超时（秒）
SUPERVISOR_SUBTASK_TIMEOUT=60
# Supervisor 是否打印详细执行日志
SUPERVISOR_VERBOSE=true
# LangGraph 工作流：是否启用人工审核（Human-in-the-Loop）
WORKFLOW_ENABLE_HITL=true
# 工作流最大循环迭代次数（超过后强制进入整合，防死循环）
WORKFLOW_MAX_ITERATIONS=10
# 工作流内单个子任务执行超时（秒）
WORKFLOW_SUBTASK_TIMEOUT=60
# LangGraph 检查点持久化目录（跨进程恢复时建议改为磁盘存储）
WORKFLOW_CHECKPOINT_DIR=./checkpoints
# API 服务监听地址
API_HOST=0.0.0.0
# API 服务监听端口
API_PORT=8000
# 开发期是否启用热重载
API_RELOAD=false
# CORS 白名单（逗号分隔；* 表示放行所有来源）
API_CORS_ORIGINS=*
# SSE 每次发送的 token 数（>1 时批量发送以减少网络往返）
SSE_BUFFER_SIZE=1
# SSE 打字机效果的帧间隔（秒）
SSE_CHUNK_DELAY=0.01
# 单次流式响应的最大时长（秒），超时发送 error 帧终止
SSE_TIMEOUT=120
# 是否发送 thinking（思考过程）事件帧
SSE_ENABLE_THINKING=true
# 日志级别（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO
